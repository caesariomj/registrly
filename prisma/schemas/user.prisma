model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  name        String?
  username    String?
  createdAt   DateTime    @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}
